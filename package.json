{
  "name": "relinker",
  "version": "1.0.0",
  "description": "Relink donor styles, variables and components to local equivalents in Figma",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es6 --platform=browser",
    "watch": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es6 --platform=browser --watch"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.101.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
